<?xml version="1.0" encoding="UTF-8"?>
<!--
  Vehicle Expense Tracker - Admin REST API (Java Spring Boot)
  Build:  mvn package        Run demo (H2):  mvn spring-boot:run
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.vehicletracker</groupId>
  <artifactId>vehicle-tracker-api</artifactId>
  <version>1.0.0</version>
  <name>Vehicle Expense Tracker API</name>
  <description>Admin REST API and dashboard for the Vehicle Expense Tracker database</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <!-- REST controllers + embedded Tomcat web server -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- JdbcTemplate: plain SQL queries against the database -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Admin login (HTTP Basic, BCrypt password hashing) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- @Valid request validation -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Swagger UI / OpenAPI documentation at /swagger-ui.html -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.8.17</version>
    </dependency>

    <!-- Database drivers: PostgreSQL (Supabase) and H2 (in-memory demo database) -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Copy the website (../*.html, css, js, assets) into the server so it is served at http://localhost:8081/ -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-website</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/public</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/..</directory>
                  <filtering>false</filtering>
                  <includes>
                    <include>*.html</include>
                    <include>css/**</include>
                    <include>js/**</include>
                    <include>assets/**</include>
                  </includes>
                  <excludes>
                    <!-- served by ConfigController instead; never copy keys -->
                    <exclude>js/config.js</exclude>
                    <exclude>**/.env</exclude>
                  </excludes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
